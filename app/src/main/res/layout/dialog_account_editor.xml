<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@color/card_dark"
    app:cardCornerRadius="16dp"
    app:cardElevation="8dp"
    android:layoutDirection="rtl">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Title -->
        <TextView
            android:id="@+id/tvDialogTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/dialog_add_title"
            android:textColor="@color/text_white"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- Locked Server Notice -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="🔒 سرور قفل شده: 185.112.33.99:7777 (ArSaCiA RPG)"
            android:textColor="@color/accent_gold"
            android:textSize="12sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="12dp"
            android:background="@color/card_stroke" />

        <!-- Nickname Input -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/hint_nickname"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/etNickname"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_input_field"
            android:hint="مثال: HarD یا SynA"
            android:textColorHint="@color/text_hint"
            android:textColor="@color/text_white"
            android:textSize="14sp"
            android:paddingHorizontal="12dp"
            android:singleLine="true" />

        <!-- Password Input -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/hint_password"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/etPassword"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_input_field"
            android:hint="رمز عبور اکانت شما در بازی..."
            android:textColorHint="@color/text_hint"
            android:textColor="@color/text_white"
            android:textSize="14sp"
            android:inputType="textPassword"
            android:paddingHorizontal="12dp"
            android:singleLine="true" />

        <!-- Options: Auto-Login & Anti-AFK -->
        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switchAutoLogin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:checked="true"
            android:text="@string/auto_login_spawn"
            android:textColor="@color/text_white"
            android:textSize="13sp" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switchAntiAfk"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:checked="true"
            android:text="@string/anti_afk"
            android:textColor="@color/text_white"
            android:textSize="13sp" />

        <!-- Action Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnSaveAccount"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:backgroundTint="@color/primary_red"
                android:text="@string/save"
                android:textColor="@color/text_white"
                android:textStyle="bold"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btnCancelDialog"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginStart="8dp"
                android:backgroundTint="#37474F"
                android:text="@string/cancel"
                android:textColor="@color/text_white"
                android:textSize="14sp" />

        </LinearLayout>

    </LinearLayout>
</androidx.cardview.widget.CardView>
