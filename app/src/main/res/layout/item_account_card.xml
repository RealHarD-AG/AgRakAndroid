<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="6dp"
    android:layout_marginVertical="6dp"
    app:cardBackgroundColor="@color/card_dark"
    app:cardCornerRadius="12dp"
    app:cardElevation="3dp"
    android:layoutDirection="rtl">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- Header: Account Nickname & Edit/Delete Icons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvAccountNick"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="👤 نام اکانت"
                android:textColor="@color/text_white"
                android:textSize="18sp"
                android:textStyle="bold" />

            <!-- Edit Icon -->
            <ImageButton
                android:id="@+id/btnEditAccount"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_edit"
                android:tint="@color/text_secondary"
                android:contentDescription="ویرایش اکانت" />

            <!-- Delete Icon -->
            <ImageButton
                android:id="@+id/btnDeleteAccount"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_delete"
                android:tint="@color/status_red"
                android:contentDescription="حذف اکانت" />
        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="8dp"
            android:background="@color/card_stroke" />

        <!-- Status & Uptime Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Animated Status 3D Icon -->
            <ImageView
                android:id="@+id/imgStatusIcon"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginStart="2dp"
                android:layout_marginEnd="6dp"
                android:src="@drawable/tg_online" />

            <!-- Status Indicator -->
            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="روشن (آنلاین)"
                android:textColor="@color/status_green"
                android:textSize="13sp"
                android:textStyle="bold" />

            <!-- Dot Separator -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="6dp"
                android:text="•"
                android:textColor="@color/text_secondary" />

            <!-- Uptime Timer -->
            <TextView
                android:id="@+id/tvUptime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="مدت زمان: 00:00:00"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Stats Section: Level, Respect, Rob, Escape -->
        <LinearLayout
            android:id="@+id/layoutStats"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@color/bg_dark"
            android:orientation="vertical"
            android:padding="10dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <!-- Level Row -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_marginStart="2dp"
                        android:layout_marginEnd="6dp"
                        android:src="@drawable/tg_crown" />

                    <TextView
                        android:id="@+id/tvStatLevel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="لول: --"
                        android:textColor="@color/accent_gold"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Respect Row -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_marginStart="2dp"
                        android:layout_marginEnd="6dp"
                        android:src="@drawable/tg_diamond" />

                    <TextView
                        android:id="@+id/tvStatRespect"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="رسپکت: --"
                        android:textColor="#00E5FF"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <!-- Rob Points Row -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_marginStart="2dp"
                        android:layout_marginEnd="6dp"
                        android:src="@drawable/tg_rob_badge" />

                    <TextView
                        android:id="@+id/tvStatRob"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="سرقت (راب): --"
                        android:textColor="#69F0AE"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Escape Points Row -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_marginStart="2dp"
                        android:layout_marginEnd="6dp"
                        android:src="@drawable/tg_escape_badge" />

                    <TextView
                        android:id="@+id/tvStatEscape"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="فرار از زندان: --"
                        android:textColor="#FF8A80"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Action Row: Connect/Disconnect Switch + Enter Chat Button -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/imgSwitchIcon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginStart="2dp"
                android:layout_marginEnd="6dp"
                android:src="@drawable/tg_switch_on" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switchConnect"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="روشن (فعال)"
                android:textColor="@color/text_white"
                android:textSize="12sp" />

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <Button
                android:id="@+id/btnEnterChat"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:backgroundTint="@color/primary_red"
                android:text="@string/enter_chat"
                android:textColor="@color/text_white"
                android:textSize="12sp" />
        </LinearLayout>

    </LinearLayout>
</androidx.cardview.widget.CardView>
