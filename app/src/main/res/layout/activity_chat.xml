<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:orientation="vertical"
    android:layoutDirection="rtl">

    <!-- Top Bar -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/card_dark"
        app:cardCornerRadius="0dp"
        app:cardElevation="4dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_revert"
                android:tint="@color/text_white"
                android:contentDescription="بازگشت" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_marginEnd="6dp"
                        android:src="@drawable/ic_instagram_verified"
                        android:contentDescription="تیک آبی" />

                    <TextView
                        android:id="@+id/tvChatAccountName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="اکانت"
                        android:textColor="@color/text_white"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvChatStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🟢 آنلاین در آرساکیا"
                    android:textColor="@color/status_green"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Server Ping / Info -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔒 ArSaCiA RPG"
                android:textColor="@color/accent_gold"
                android:textSize="12sp"
                android:textStyle="bold" />

        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Quick Command Shortcuts Bar -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#181B22"
        android:paddingVertical="4dp"
        android:paddingHorizontal="8dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnQuickReconnect"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginEnd="6dp"
                android:backgroundTint="#3E2723"
                android:text="🔄 اتصال مجدد (!reconnect)"
                android:textColor="@color/text_white"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btnQuickStats"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginEnd="6dp"
                android:backgroundTint="#004D40"
                android:text="📊 استعلام آمار (/stats)"
                android:textColor="@color/text_white"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btnQuickSleep"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:backgroundTint="#1A237E"
                android:text="💤 حالت خواب (/sleep)"
                android:textColor="@color/text_white"
                android:textSize="11sp" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Official Server Chat Header Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:background="#15171D"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="💬 چت رسمی و زنده سرور"
            android:textColor="@color/text_white"
            android:textStyle="bold"
            android:textSize="12sp" />

        <CheckBox
            android:id="@+id/cbFilterSmsAds"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:checked="true"
            android:buttonTint="@color/accent_gold"
            android:text="حذف تبلیغ/SMS"
            android:textColor="#E0E0E0"
            android:textSize="11sp" />

    </LinearLayout>

    <!-- Chat / Console Output Box -->
    <ScrollView
        android:id="@+id/scrollConsole"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#0D0E11"
        android:padding="10dp"
        android:fillViewport="true">

        <TextView
            android:id="@+id/tvConsoleLogs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#E0E0E0"
            android:textSize="12sp"
            android:typeface="monospace"
            android:textIsSelectable="true"
            android:text="💬 در حال اتصال به سرور و راه‌اندازی اسلیپ...\n" />
    </ScrollView>

    <!-- Bottom Message Input Row -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/card_dark"
        app:cardCornerRadius="0dp"
        app:cardElevation="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="8dp">

            <EditText
                android:id="@+id/etChatMessage"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:background="@drawable/bg_input_field"
                android:hint="پیام یا دستور (مثلاً: سلام یا /time)..."
                android:textColorHint="@color/text_hint"
                android:textColor="@color/text_white"
                android:textSize="13sp"
                android:paddingHorizontal="12dp"
                android:singleLine="true" />

            <Button
                android:id="@+id/btnSendMessage"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:layout_marginStart="8dp"
                android:backgroundTint="@color/primary_red"
                android:text="@string/send"
                android:textColor="@color/text_white"
                android:textStyle="bold"
                android:textSize="13sp" />

        </LinearLayout>
    </androidx.cardview.widget.CardView>

</LinearLayout>
